/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://maps.austintexas.gov https://cloudflareinsights.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; base-uri 'none'; form-action 'self' https://app.kit.com; frame-ancestors 'none'; object-src 'none'

/meetings/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
